# Auto-activate Python .venv when entering this directory (direnv).
# One-time: python3 -m venv .venv && pip install -e .  then: direnv allow
if [ -d .venv/bin ]; then
  PATH_add .venv/bin
  export VIRTUAL_ENV=$PWD/.venv
fi
# Load API keys etc. from .env (gitignored). Copy .env.example to .env and fill in.
source_env_if_exists .env
